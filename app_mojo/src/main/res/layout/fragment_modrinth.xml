<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    android:padding="16dp">

    <!-- Заголовок раздела -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Поиск модов (Modrinth)"
        android:textColor="@color/primary_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Поле ввода поискового запроса -->
    <EditText
        android:id="@+id/edit_search_mod"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Введите название мода (например, Sodium)..."
        android:textColor="@color/primary_text"
        android:textColorHint="@color/secondary_text"
        android:background="@color/background_overlay"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Изумрудная кнопка поиска -->
    <Button
        android:id="@+id/btn_search_mod"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Найти"
        android:textColor="@color/emerald_on_primary"
        android:textStyle="bold"
        android:backgroundTint="@color/minebutton_color"
        android:layout_marginBottom="16dp" />

    <!-- Список результатов -->
    <ListView
        android:id="@+id/list_modrinth_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

</LinearLayout>
