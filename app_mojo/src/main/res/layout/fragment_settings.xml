<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки DuuttoLauncher"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Переключатель тем -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background_overlay"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тема оформления"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/background_status_bar" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Системные разделы"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Кнопки перехода к родным настройкам Mojo со скриншотов -->
        <Button
            android:id="@+id/btn_graphics_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Настройки графики"
            android:textColor="@color/primary_text"
            android:backgroundTint="@color/background_overlay"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_controls_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Настройки управления"
            android:textColor="@color/primary_text"
            android:backgroundTint="@color/background_overlay"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_java_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Настройки Java и памяти"
            android:textColor="@color/primary_text"
            android:backgroundTint="@color/background_overlay"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_other_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Другие настройки"
            android:textColor="@color/primary_text"
            android:backgroundTint="@color/background_overlay"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
